+#include "myagv_odometry/myAGV.h"
+
+#include "rclcpp/rclcpp.hpp"
+#include "geometry_msgs/msg/twist.hpp"
+#include <iostream>
+#include <cstring>
+#include <atomic>
+#include <thread>
+#include <chrono>
+#include <cstdint>
+
+std::atomic<double> linearX{0.0};
+std::atomic<double> linearY{0.0};
+std::atomic<double> angularZ{0.0};
+
+// Marca de tiempo (steady clock, nanosegundos) del ultimo /cmd_vel.
+std::atomic<int64_t> lastCmdNs{0};
+
+// WATCHDOG DE VELOCIDAD
+// =====================
+// Sin esto, este nodo guardaba el ultimo /cmd_vel y lo reenviaba a los
+// motores a 100 Hz PARA SIEMPRE: si el emisor callaba (nodo muerto,
+// twist_mux con todas sus entradas en timeout, o -sobre todo- el enlace
+// WiFi caido cuando el procesamiento corre en un portatil externo), el
+// robot seguia rodando a la ultima velocidad ordenada. Un AMR no puede
+// depender de que "alguien siga hablando" para frenar.
+//
+// 0.30 s: por encima del timeout de 0.5 s de twist_mux seria inutil, y
+// por debajo de ~0.2 s un hipo normal de red frenaria el robot a
+// tirones. Los emisores publican a >= 10 Hz, asi que 0.3 s son 3
+// mensajes perdidos seguidos.
+constexpr int64_t CMD_TIMEOUT_NS = 300LL * 1000LL * 1000LL;
+
+//using namespace std;
+
+void cmdCallback(const geometry_msgs::msg::Twist::SharedPtr msg)
+{
+    linearX.store(msg->linear.x, std::memory_order_relaxed);
+    linearY.store(msg->linear.y, std::memory_order_relaxed);
+    angularZ.store(msg->angular.z, std::memory_order_relaxed);
+    lastCmdNs.store(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count(),
+        std::memory_order_relaxed);
+    //RCLCPP_INFO(rclcpp::get_logger("myagv_odometry_node"), "cmdCallback: linearX: %.2f, linearY: %.2f, angularZ: %.2f", linearX, linearY, angularZ);
+}
+
+int main(int argc, char* argv[])
+{
+    rclcpp::init(argc, argv);
+    auto node = std::make_shared<MyAGV>("myagv_odometry_node");
+
+    if (!node->init()) {
+        RCLCPP_ERROR(node->get_logger(), "myAGV initialized failed!");
+        return 1;
+    }
+    RCLCPP_INFO(node->get_logger(), "myAGV initialized successful!");
+
+    auto sub = node->create_subscription<geometry_msgs::msg::Twist>("cmd_vel", 50, cmdCallback);
+    rclcpp::Rate command_rate(100);
+
+    // Telemetry is a blocking serial read (~12 Hz). Keep command writes on
+    // the fast path so they do not wait for the next telemetry packet.
+    std::thread telemetry_thread([&node]() {
+        while (rclcpp::ok()) {
+            node->readTelemetry();
+        }
+    });
+
+    bool stopped_by_watchdog = false;
+
+    while (rclcpp::ok()) {
+        rclcpp::spin_some(node);
+
+        const int64_t now_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+        const int64_t last_ns = lastCmdNs.load(std::memory_order_relaxed);
+
+        // last_ns == 0 -> aun no ha llegado ningun /cmd_vel: quietos.
+        const bool cmd_fresh =
+            (last_ns != 0) && ((now_ns - last_ns) < CMD_TIMEOUT_NS);
+
+        if (cmd_fresh) {
+            if (stopped_by_watchdog) {
+                RCLCPP_INFO(node->get_logger(),
+                            "cmd_vel restablecido; se reanuda el control.");
+                stopped_by_watchdog = false;
+            }
+            node->sendCommand(
+                linearX.load(std::memory_order_relaxed),
+                linearY.load(std::memory_order_relaxed),
+                angularZ.load(std::memory_order_relaxed));
+        } else {
+            if (!stopped_by_watchdog && last_ns != 0) {
+                RCLCPP_WARN(node->get_logger(),
+                            "WATCHDOG: sin /cmd_vel en %.0f ms. Motores a cero.",
+                            CMD_TIMEOUT_NS / 1e6);
+                stopped_by_watchdog = true;
+            }
+            node->sendCommand(0.0, 0.0, 0.0);
+        }
+
+        command_rate.sleep();
+    }
+
+    if (telemetry_thread.joinable()) {
+        telemetry_thread.join();
+    }
+    rclcpp::shutdown();
+    return 0;
+}
