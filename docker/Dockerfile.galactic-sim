FROM ros:galactic-ros-base-focal

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=galactic

SHELL ["/bin/bash", "-c"]

# ------------------------------------------------------------
# Herramientas base
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    sudo \
    git \
    curl \
    wget \
    nano \
    vim \
    less \
    procps \
    iproute2 \
    iputils-ping \
    net-tools \
    mesa-utils \
    python3-pip \
    python3-yaml \
    python3-numpy \
    python3-opencv \
    python3-rosdep \
    python3-vcstool \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# ROS 2 Galactic Desktop / GUI
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    ros-galactic-desktop \
    ros-galactic-rviz2 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Gazebo Classic
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    gazebo11 \
    ros-galactic-gazebo-ros-pkgs \
    ros-galactic-gazebo-plugins \
    ros-galactic-gazebo-ros2-control \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# ros2_control
#
# NO instalamos mecanum_drive_controller explícitamente.
# La compatibilidad Galactic la resolveremos aparte.
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    ros-galactic-ros2-control \
    ros-galactic-ros2-controllers \
    ros-galactic-controller-manager \
    ros-galactic-joint-state-broadcaster \
    ros-galactic-joint-trajectory-controller \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Navegación
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    ros-galactic-navigation2 \
    ros-galactic-nav2-bringup \
    ros-galactic-slam-toolbox \
    ros-galactic-twist-mux \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Percepción / TF / descripción
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    ros-galactic-cv-bridge \
    ros-galactic-image-transport \
    ros-galactic-camera-info-manager \
    ros-galactic-tf2-tools \
    ros-galactic-xacro \
    ros-galactic-robot-state-publisher \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# rosdep
# ------------------------------------------------------------

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
        rosdep init; \
    fi && \
    rosdep update

# ------------------------------------------------------------
# Usuario normal
# ------------------------------------------------------------

ARG USERNAME=robot
ARG USER_UID=1000
ARG USER_GID=1000

RUN if ! getent group ${USER_GID} >/dev/null; then \
        groupadd --gid ${USER_GID} ${USERNAME}; \
    fi && \
    if ! id -u ${USERNAME} >/dev/null 2>&1; then \
        useradd \
            --uid ${USER_UID} \
            --gid ${USER_GID} \
            -m \
            -s /bin/bash \
            ${USERNAME}; \
    fi && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" \
        > /etc/sudoers.d/${USERNAME}

USER ${USERNAME}

WORKDIR /workspace

ENV QT_X11_NO_MITSHM=1

RUN echo 'source /opt/ros/galactic/setup.bash' \
    >> /home/${USERNAME}/.bashrc

CMD ["/bin/bash"]
