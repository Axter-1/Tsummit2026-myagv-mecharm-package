<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>home_service_navigation</name>
  <version>0.0.1</version>
  <description>
    Nodos de navegacion del myAGV: saneador del LaserScan (elimina las
    paredes fantasma del costmap) y ejecutor del reto de laberinto.
  </description>
  <maintainer email="alex@example.com">alex</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>python3-numpy</depend>

  <!-- Opcional: solo si se quiere recoger el brazo antes del laberinto. -->
  <exec_depend>home_service_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
