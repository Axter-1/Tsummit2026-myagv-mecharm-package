<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>home_service_behaviors</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="alex@todo.todo">alex</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>home_service_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- offboard.launch.py arranca tambien el detector ArUco, que corre
       en este mismo paquete-launch cuando el procesamiento va fuera
       del robot. -->
  <exec_depend>home_service_perception</exec_depend>
  <!-- offboard.launch.py con start_foxglove:=true levanta el puente
       Foxglove en el portatil. Opcional: nodo condicionado, off por
       defecto. -->
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
