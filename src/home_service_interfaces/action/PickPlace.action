# ============================================================
# GOAL
#
# Primitiva de toma ('pick') o colocacion ('place') ejecutada
# SOLO con el brazo + gripper.
#
# El posicionamiento de la base movil (Nav2 + aproximacion
# ArUco) es responsabilidad de quien invoca esta accion.
#
# El objetivo del agarre/soltado se indica de UNA de estas
# dos formas (en el frame base del brazo):
#
#   target_pose_name -> pose con nombre (poses.yaml)
#   target_coords    -> [X, Y, Z, RX, RY, RZ] mm / grados
#
# Para un preagarre cartesiano ensenado, se pueden pasar 12 valores:
#   [agarre X,Y,Z,RX,RY,RZ, preagarre X,Y,Z,RX,RY,RZ]
# En ese caso approach_height se ignora: el preagarre explicito manda.
# ============================================================

# "pick" | "place"
string operation

# ArUco de la UBICACION a la que aproximarse. -1 = deducirlo del
# catalogo por la pieza, que es el comportamiento antiguo.
#
# POR QUE HIZO FALTA: en los retos del T-SUMMIT los ArUco 0..3 marcan
# ESTACIONES (recogida verde, entrega verde, recogida azul, entrega
# azul), no piezas. Deducir el marcador de la pieza via
# `aruco_to_object` mandaba el robot a la estacion equivocada: con
# operation=pick y la pieza "rueda" se iba al ArUco 3 aunque la
# recogida estuviese en el 0.
int32 marker_id -1

string target_pose_name

float64[] target_coords

# Alternativa a target_coords: pose final ensenada [J1..J6] en grados.
# Se usa con approach_joint_waypoints para rutas calibradas que el IK del
# firmware no puede reproducir de forma segura.
float64[] target_joint_angles

# Waypoints articulares ensenados, aplanados en grupos de seis valores.
# Se recorren en orden antes de DESCEND y en orden inverso durante LIFT.
float64[] approach_joint_waypoints

# Waypoints cartesianos ensenados, aplanados en grupos de seis valores.
# Se recorren en orden antes de DESCEND y en orden inverso durante LIFT.
float64[] approach_coords_waypoints

# Pose articular inicial opcional antes de abrir la pinza y aproximarse.
# Para el poste se usa "home" para no iniciar desde una rama anterior.
string initial_pose_name

# Holgura vertical (mm) para los waypoints de aproximacion y
# retirada, por encima del objetivo.
float64 approach_height 60.0

# Valores de apertura del gripper (0..100, dependientes del
# hardware). <= 0 -> usa los valores por defecto del nodo.
int32 gripper_open_value 0
int32 gripper_closed_value 0

# 0..100. <= 0 -> velocidades por defecto del nodo.
float64 speed_percent 0.0
float64 gripper_speed_percent 0.0

# Fuerza/par de la pinza adaptativa. 0 = usar el ajuste del driver.
int32 gripper_torque 0

# true = fuerza controlada; false = posicion/apertura solamente.
bool gripper_force_control false

# Corriente de proteccion del gripper, 1..500. 0 = ajuste del firmware.
int32 gripper_protect_current 0

# Pose de retirada opcional al terminar ("" = no ir a ninguna).
string retreat_pose_name

---
# ============================================================
# RESULT
# ============================================================

bool success

# OK
# INVALID_GOAL
# GRASP_FAILED
# ARM_FAULT
# TIMEOUT
# CANCELED
string status

string message

---
# ============================================================
# FEEDBACK
# ============================================================

# APPROACH
# VERIFY_POSE
# RECOVERING
# DESCEND
# GRIP
# LIFT
# RETREAT
string state
